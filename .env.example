# Example only. Copy privately; never commit real values.
APP_MODE=local_synthetic_demo
APP_HOST=127.0.0.1
CASE_DB_PATH=runtime/cases.sqlite
CHECKPOINT_DB_PATH=runtime/checkpoints.sqlite
QDRANT_MODE=local
QDRANT_PATH=runtime/qdrant
QDRANT_COLLECTION=legal_reference_v1
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_CACHE_DIR=runtime/model_cache
# Confirm actual available version/account in the official docs and smoke test.
JEV_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
# Jev document routing (candidate class only, MANUAL fallback) runs when TYPESAFE_API_KEY is set.
# Set JEV_ENABLED=false to keep it off even with a key.
JEV_ENABLED=true
# Choose ONE runtime provider after an actual successful call.
# manual | openai (defaults to openai when OPENAI_API_KEY is set)
LLM_PROVIDER=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini-2024-07-18
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=boussla-synthetic-demo
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
C2PA_ENABLED=false
PDF_SIGNATURE_CHECK_ENABLED=false
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=5
MAX_QUESTION_ROUNDS=2
GENERAL_MODEL_TIMEOUT_SECONDS=30
JEV_TIMEOUT_SECONDS=5
# No real email/portal/bank connector keys are part of this application.
UPLOAD_DIR=runtime/uploads
EVENT_LOG_PATH=runtime/events.jsonl
# Verify TLS with the OS trust store (for TLS-inspecting antivirus/proxies). Never disables verification.
BOUSSLA_OS_TRUSTSTORE=true
